{
  "manifest_version": 3,
  "name": "Multi Login Tabs",
  "version": "0.1.0",
  "description": "Stay logged in as several users at once in normal tabs, on any site.",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/sushil026/multi-login-tabs",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Multi Login Tabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["declarativeNetRequest", "webRequest", "webNavigation", "tabGroups", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/shim-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
